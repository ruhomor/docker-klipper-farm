version: "3"
## Service Definitions
services:

  {% for i in range(1, number_of_instances + 1) %}
  ## Klippy Services
  ##
  klipper-{{ i }}:
    image: mkuf/klipper:latest
    restart: unless-stopped
    privileged: true
    logging:
      driver: none
    depends_on:
      init-{{ i }}:
        condition: service_completed_successfully
      socat-{{ i }}:
        condition: service_started
    command: -I printer_data/run/klipper-{{ i }}.tty -a printer_data/run/klipper-{{ i }}.sock printer_data/config/printer.cfg -l printer_data/logs/klippy-{{ i }}.log
    volumes:
      - /dev:/dev
      - ./config-{{ i }}:/opt/printer_data/config
      - run:/opt/printer_data/run
      - gcode:/opt/printer_data/gcodes
      - log:/opt/printer_data/logs
    labels:
      org.prind.service: klipper-{{ i }}

  ## WebApi
  ##
  moonraker-{{ i }}:
    image: mkuf/moonraker:latest
    restart: unless-stopped
    pid: host
    logging:
      driver: none
    depends_on:
      init-{{ i }}:
        condition: service_completed_successfully
      klipper-{{ i }}:
        condition: service_started
    volumes:
      - /dev/null:/opt/klipper/config/null
      - /dev/null:/opt/klipper/docs/null
      - /run/dbus:/run/dbus
      - /run/systemd:/run/systemd
      - run:/opt/printer_data/run
      - gcode:/opt/printer_data/gcodes
      - log:/opt/printer_data/logs
      - moonraker-db:/opt/printer_data/database
      - ./config-{{ i }}:/opt/printer_data/config
    labels:
      org.prind.service: moonraker-{{ i }}
      traefik.enable: true
      traefik.http.services.moonraker-{{ i }}.loadbalancer.server.port: 7125
      traefik.http.routers.moonraker-{{ i }}.rule: PathPrefix(`/`)
      traefik.http.routers.moonraker-{{ i }}.entrypoints: web{{ i }}

  init-{{ i }}:
    image: busybox:latest
    command: chown -R 1000:1000 /prind/config-{{ i }}
    volumes:
      - .:/prind
    labels:
      org.prind.service: init-{{ i }}

  socat-{{ i }}:
    image: alpine/socat:1.7.4.4
    privileged: true
    container_name: socat-{{ i }}
    command: "-d -d -d -x pty,link=/dev/virtualcom{{ i }},raw,group-late=dialout,mode=660,ixon=1,ixoff=1,parenb=1,parodd=1,cstopb=1,cs8 tcp:10.0.1.{{ 9 + i }}:23"
    volumes:
      - "/dev:/dev"
    restart: unless-stopped
    logging:
      driver: none
    labels:
      org.prind.service: socat-{{ i }}
  {% endfor %}

  ## Frontends
  ##
  #octoprint:
  #  image: octoprint/octoprint:minimal
  #  restart: unless-stopped
  #  depends_on:
  #    klipper:
  #      condition: service_started
  #  privileged: true
  #  volumes:
  #    - /dev:/dev
  #    - run:/opt/printer_data/run
  #    - octoprint:/octoprint
  #    - ./config/octoprint.yaml:/octoprint/octoprint/config.yaml
  #  profiles:
  #    - octoprint
  #  labels:
  #    org.prind.service: octoprint
  #    traefik.enable: true
  #    traefik.http.services.octoprint.loadbalancer.server.port: 5000
  #    traefik.http.routers.octoprint.rule: PathPrefix(`/`)
  #    traefik.http.routers.octoprint.entrypoints: web

  fluidd:
    image: ghcr.io/fluidd-core/fluidd:latest
    restart: unless-stopped
    profiles:
      - fluidd
    labels:
      org.prind.service: fluidd
      traefik.enable: true
      traefik.http.services.fluidd.loadbalancer.server.port: 80
      traefik.http.routers.fluidd.rule: PathPrefix(`/`)
      traefik.http.routers.fluidd.entrypoints: web

  mainsail:
    image: ghcr.io/mainsail-crew/mainsail:edge
    restart: unless-stopped
    profiles:
      - mainsail
    labels:
      org.prind.service: mainsail
      traefik.enable: true
      traefik.http.services.mainsail.loadbalancer.server.port: 80
      traefik.http.routers.mainsail.rule: PathPrefix(`/`)
      traefik.http.routers.mainsail.entrypoints: web

  ## additional Services
  ##
  klipperscreen:
    image: mkuf/klipperscreen:latest
    restart: unless-stopped
    network_mode: host
    pid: host
    profiles:
      - klipperscreen
    volumes:
      - /run/systemd:/run/systemd
      - /etc/localtime:/etc/localtime:ro
      - /tmp/.X11-unix:/tmp/.X11-unix
      - ./config:/opt/cfg
    labels:
      org.prind.service: klipperscreen

  moonraker-telegram-bot:
    image: lefskiy/moonraker-telegram-bot:latest
    restart: unless-stopped
    logging:
      driver: none
    profiles:
      - moonraker-telegram-bot
    volumes:
      - gcode:/opt/printer_data/gcodes
      - log:/opt/printer_data/logs
      - ./config:/opt/printer_data/config
    labels:
      org.prind.service: moonraker-telegram-bot

  mobileraker_companion:
    image: ghcr.io/clon1998/mobileraker_companion:latest
    restart: unless-stopped
    profiles:
      - mobileraker_companion
    volumes:
      - ./config:/opt/printer_data/config
    labels:
      org.prind.service: mobileraker_companion

  hostmcu:
    image: mkuf/klipper:latest-hostmcu
    restart: unless-stopped
    privileged: true
    volumes:
      - /dev:/dev
      - run:/opt/printer_data/run
    profiles:
      - hostmcu
    labels:
      org.prind.service: hostmcu

  ## Loadbalancer/Proxy
  traefik:
    image: traefik:v2.5
    command:
      - "--accesslog"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
{% for i in range(1, number_of_instances + 1) %}
      - "--entrypoints.web{{ i }}.address=:{{ 7124 + i }}"
{% endfor %}
    ports:
      - "80:80"
{% for i in range(1, number_of_instances + 1) %}
      - "{{ 7124 + i }}:{{ 7124 + i }}"
{% endfor %}
    restart: unless-stopped
    volumes:
        - "/var/run/docker.sock:/var/run/docker.sock:ro"
    labels:
      org.prind.service: traefik

volumes:
  run:
    driver_opts:
      type: tmpfs
      device: tmpfs
  dev:
    driver_opts:
      type: tmpfs
      device: tmpfs
  gcode:
  octoprint:
  moonraker-db:
  log:
    driver_opts:
      type: tmpfs
      device: tmpfs
      